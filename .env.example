# ============================================================
#  deep-hire — yagona .env.example
#  Nusxa oling: Copy-Item .env.example .env
#  Keyin barcha qiymatlarni to'ldiring.
# ============================================================

# ── Deploy ────────────────────────────────────────────────────
PROJECT_NAME=deep-hire

# ── MongoDB ───────────────────────────────────────────────────
# MUHIM: MONGO_USER va MONGO_PASSWORD ni haqiqiy qiymatlar bilan to'ldiring!
# MongoDB admin user parolini bilmasangiz: sudo mongosh -> db.changeUserPassword("admin","yangiparol")
MONGO_USER=admin
MONGO_PASSWORD=CHANGE_ME_REAL_PASSWORD
MONGO_URI=mongodb://admin:CHANGE_ME_REAL_PASSWORD@localhost:27017/?authSource=admin
MONGO_DB=deephire

# ── Redis ─────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── MinIO ─────────────────────────────────────────────────────
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=deephire-uploads
MINIO_SECURE=false

# ── LiteLLM (on-prem OpenAI-compatible proxy) ────────────────
# Bank ichidagi LiteLLM server manzili
OLLAMA_BASE_URL=http://localhost:8080
LITELLM_API_KEY=
# LLM scoring: false = tez vektor skoring, true = LiteLLM orqali AI skoring
USE_LLM_SCORING=false
# LLM — scoring, extraction, search query generation
OLLAMA_MODEL=gpt-oss-120
# Embed model — RAG indexing & vacancy/resume similarity
OLLAMA_EMBED_MODEL=bge-m3:latest

# ── Cross-encoder Reranker (HuggingFace) ─────────────────────
# Vektor qidiruvdan keyin cross-encoder bilan qayta tartiblash.
# Model birinchi ishga tushganda HF Hub dan yuklanadi (~1 GB).
# Tavsiya: BAAI/bge-reranker-v2-m3 (ko'p tilli, RU/UZ uchun ideal).
# false = tez cosine+skill scoring, true = cross-encoder reranking
USE_RERANKER=false
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
# Qdrant dan olingan nechta kandidatni reranker-ga yuborish
RERANKER_TOP_N=30
# Reranking dan keyin nechta kandidatni saqlash
RERANKER_SAVE_N=15

# ── Qdrant (RAG / vector store) ───────────────────────────────
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=uzbek_candidates

# ── HH.uz OAuth (integration) ─────────────────────────────────
# HH ilovasida ro'yxatdan o'tgan redirect_uri:  https://YOUR_DOMAIN/callback
HH_CLIENT_ID=
HH_CLIENT_SECRET=
HH_REDIRECT_URI=https://YOUR_DOMAIN/callback
HH_BASE_URL=https://api.hh.uz
HH_OAUTH_URL=https://hh.uz/oauth/authorize
HH_TOKEN_URL=https://hh.uz/oauth/token
HH_HOST=hh.uz

# ── App ───────────────────────────────────────────────────────
APP_USER_AGENT=DeepHire/1.0
# Tashqi URL — nginx orqali kirish manzili
FRONTEND_URL=https://YOUR_DOMAIN_OR_IP:8385
# Log darajasi: info (odatiy) | debug (MCP request/response detallari uchun)
LOG_LEVEL=info

# ── JWT Authentication ────────────────────────────────────────
# Generatsiya: python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-me-use-python3-secrets-token-hex-32
JWT_EXPIRE_MINUTES=10080

# ── Cleverstaff MCP sync ─────────────────────────────────────
# Sync-ni o'chirish uchun: CLEVERSTAFF_SYNC_ENABLED=false
CLEVERSTAFF_SYNC_ENABLED=true
CLEVERSTAFF_MCP_URL=http://172.31.174.11:8765/mcp
CLEVERSTAFF_MCP_TOKEN=
CLEVERSTAFF_SYNC_HOUR=2

# ── Frontend (Next.js) ────────────────────────────────────────
NEXT_PUBLIC_API_URL=https://YOUR_DOMAIN_OR_IP:8385
PORT=3001
