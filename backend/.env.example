# ============================================================
#  backend/.env — Backend servis sozlamalari
#  Nusxa: Copy-Item backend\.env.example backend\.env
# ============================================================

# ── MongoDB ───────────────────────────────────────────────────
# Docker ichida: mongodb://admin:PASSWORD@host.docker.internal:27017
# Lokal:         mongodb://localhost:27017
MONGO_URI=mongodb://admin:changeme@host.docker.internal:27017
MONGO_DB=deephire

# ── Redis ────────────────────────────────────────────────────
REDIS_URL=redis://host.docker.internal:6379

# ── MinIO ────────────────────────────────────────────────────
MINIO_ENDPOINT=host.docker.internal:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=deephire-uploads
MINIO_SECURE=false

# ── Ollama (AI model) ────────────────────────────────────────
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=gpt-oss:20b-cloud

# ── Qdrant (vector store) ────────────────────────────────────
QDRANT_URL=http://host.docker.internal:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=uzbek_candidates
EMBED_MODEL=nomic-embed-text

# ── HH.uz OAuth ──────────────────────────────────────────────
# HH ilovasida ro'yxatdan o'tgan redirect_uri:
#   https://YOUR_DOMAIN/callback
# Haqiqiy qiymatlarni to'ldiring, hech qachon commit qilmang!
HH_CLIENT_ID=
HH_CLIENT_SECRET=
HH_REDIRECT_URI=https://YOUR_DOMAIN_OR_NGROK/callback
HH_BASE_URL=https://api.hh.uz
HH_OAUTH_URL=https://hh.uz/oauth/authorize
HH_TOKEN_URL=https://hh.uz/oauth/token
HH_HOST=hh.uz

# ── App ───────────────────────────────────────────────────────
APP_USER_AGENT=DeepHire/1.0
# Frontend URL — HH OAuth redirect va CORS uchun
FRONTEND_URL=https://YOUR_DOMAIN_OR_IP:8085

# ── JWT Authentication ────────────────────────────────────────
# Kamida 32 ta tasodifiy belgi ishlatib o'zgartiring!
# Generatsiya: python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-me-in-production-use-a-long-random-string
# Token muddati (daqiqa): 10080 = 7 kun
JWT_EXPIRE_MINUTES=10080
