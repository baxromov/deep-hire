# ── Infrastructure (overridden by docker-compose environment block) ──────────
# These are used only when running the backend locally outside Docker.
MONGO_URI=mongodb://localhost:27017
MONGO_DB=deephire

REDIS_URL=redis://localhost:6379

MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=deephire-uploads
MINIO_SECURE=false

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gpt-oss:20b-cloud

# ── HH.uz OAuth — fill in real values, never commit ─────────────────────────
HH_CLIENT_ID=
HH_CLIENT_SECRET=
HH_REDIRECT_URI=
HH_BASE_URL=https://api.hh.uz
HH_OAUTH_URL=https://hh.uz/oauth/authorize
HH_TOKEN_URL=https://hh.uz/oauth/token
HH_HOST=hh.uz

# ── App ───────────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3001
APP_USER_AGENT=DeepHire/1.0
